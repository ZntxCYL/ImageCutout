<Window x:Class="ImageCutout.Win.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ImageCutout · AI 抠图" Width="1100" Height="720" MinWidth="820" MinHeight="530" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Background="{DynamicResource ThemeWindow}" Foreground="{DynamicResource ThemeText}" AllowDrop="True" Drop="OnDrop" Closing="OnClosing" Loaded="OnLoaded">
 <Window.Resources>
  <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
   <DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#EFEFEF" Geometry="M0,0 H24 V24 H0 Z"/><GeometryDrawing Brush="#C9C9C9" Geometry="M0,0 H12 V12 H0 Z M12,12 H24 V24 H12 Z"/></DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
  <Style TargetType="Button" BasedOn="{StaticResource FooterButton}"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="30"/></Style>
 </Window.Resources>
 <DockPanel Margin="16" LastChildFill="True">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <DockPanel><TextBlock Text="ImageCutout" FontSize="24" FontWeight="SemiBold"/><Button x:Name="UpdateButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="CheckUpdate" Content="检查更新"/><TextBlock Text="本地 AI · v0.1" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource ThemeSecondaryText}"/></DockPanel>
   <WrapPanel Margin="0,12,0,0" x:Name="Controls"><Button Click="AddFiles" Content="添加图片"/><Button Click="AddFolder" Content="添加目录"/><Button Click="Clear" Content="清空"/><Button Click="ImportModel" Content="导入模型"/><ComboBox x:Name="Models" Width="190" Margin="0,0,8,0"/><ComboBox x:Name="Devices" Width="150" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="GPU 优先 (DirectML)"/><ComboBoxItem Content="CPU"/></ComboBox><Button Click="ChooseOutput" Content="输出目录"/><Button Click="Start" Content="开始抠图"/></WrapPanel>
   <TextBlock x:Name="OutputText" Margin="0,8,0,0" Text="输出：原图旁 ImageCutout 文件夹" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button x:Name="CancelButton" DockPanel.Dock="Right" IsEnabled="False" Click="Cancel" Content="取消任务"/><ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="140" Height="12" Margin="10,0"/><TextBlock x:Name="Status" Text="拖入图片或目录开始 · 不上传原图" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Queue" SelectionChanged="SelectionChanged" Background="{DynamicResource ThemeInput}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State}" Foreground="{DynamicResource ThemeSecondaryText}" FontSize="11" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <DockPanel><TextBlock DockPanel.Dock="Top" Text="原始图片" Margin="0,0,0,8" FontWeight="SemiBold"/><Border Background="{StaticResource Checker}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"><Image x:Name="Original" Stretch="Uniform"/></Border></DockPanel>
    <DockPanel Grid.Column="2"><TextBlock DockPanel.Dock="Top" Text="透明 PNG · 处理结果" Margin="0,0,0,8" FontWeight="SemiBold"/><Border Background="{StaticResource Checker}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"><Image x:Name="Result" Stretch="Uniform"/></Border></DockPanel>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
